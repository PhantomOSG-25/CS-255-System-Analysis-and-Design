digraph SecureLogin {
  graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.30", ranksep="0.42", splines=ortho, fontname="Arial", label="Secure login activity", labelloc=t, fontsize=24];
  node [shape=box, style="rounded,filled", fillcolor="#F4F5F7", color="#6B7280", fontname="Arial", fontsize=12, margin="0.15,0.10"];
  edge [color="#64748B", arrowsize=0.7, fontname="Arial", fontsize=10];

  start [shape=circle, label="", width=0.22, height=0.22, fixedsize=true, fillcolor="#111827", color="#111827"];
  display [label="Display sign-in form"];
  submit [label="Submit username and password"];
  valid [shape=diamond, label="Credentials valid?", fillcolor="#E8F4FF", color="#3D8DFF"];
  fail [label="Record failed attempt\nand apply rate limit"];
  locked [shape=diamond, label="Threshold reached?", fillcolor="#E8F4FF", color="#3D8DFF"];
  lock [label="Temporarily lock account\nand send security alert", fillcolor="#FFF1F1", color="#C94949"];
  retry [label="Return a generic error"];
  privileged [shape=diamond, label="Privileged role?", fillcolor="#E8F4FF", color="#3D8DFF"];
  mfa [label="Request second factor"];
  mfavalid [shape=diamond, label="Second factor valid?", fillcolor="#E8F4FF", color="#3D8DFF"];
  session [label="Create secure session\nand record audit event", fillcolor="#E9F8EF", color="#2E8B57"];
  end [shape=doublecircle, label="", width=0.24, height=0.24, fixedsize=true, fillcolor="#111827", color="#111827"];

  start -> display -> submit -> valid;
  valid -> fail [label="No"];
  fail -> locked;
  locked -> lock [label="Yes"];
  locked -> retry [label="No"];
  retry -> display;
  lock -> end;
  valid -> privileged [label="Yes"];
  privileged -> session [label="No"];
  privileged -> mfa [label="Yes"];
  mfa -> mfavalid;
  mfavalid -> session [label="Yes"];
  mfavalid -> fail [label="No"];
  session -> end;
}
